{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  },
  /**
   * Không có "exclude", TypeScript quét MỌI file .ts/.tsx từ thư mục gốc —
   * bao gồm cả frontend/, vốn là project Next.js riêng với tsconfig riêng
   * (có "jsx": "preserve"). Hậu quả: `yarn build` ở backend báo hàng loạt
   * lỗi "Cannot use JSX unless the '--jsx' flag is provided".
   * Khoanh vùng lại: backend chỉ biên dịch src/ và test/.
   */
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist", "frontend"]
}
