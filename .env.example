DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nestjs_db

APP_PORT=3000

# ─────────── AUTH ───────────
# Chuỗi bí mật để KÝ JWT. Đổi thành chuỗi ngẫu nhiên dài, KHÔNG commit.
# Sinh nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=doi-chuoi-nay-thanh-mot-chuoi-ngau-nhien-that-dai
JWT_EXPIRES_IN=7d

# Nơi backend đẩy user quay về sau khi đăng nhập Google xong
FRONTEND_URL=http://localhost:3001

# Lấy ở https://console.cloud.google.com → APIs & Services → Credentials
# → Create OAuth client ID → Web application.
# Authorized redirect URI phải điền ĐÚNG giá trị GOOGLE_CALLBACK_URL dưới đây.
# Bỏ trống 3 dòng này thì app vẫn chạy, chỉ là không có nút Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
